      }
    },
    "roleDefinitionIds": {
      "type": "array",
      "defaultValue": [
        "acdd72a7-3385-48ef-bd42-f606fba81ae7"
      ],
      "metadata": {
        "description": "IDs de definición de rol a asignar. Por defecto: Reader."
      }
    }
  },
  "resources": [
