        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionIds')[copyIndex()])]",
        "description": "Claranet - auditoria e inventario (solo lectura)"
      }
